using Gtk 4.0;
using Granite 7.0;
using Adw 1;

template $PaperNoteList: Granite.Bin {
  child: Adw.ToolbarView {
    bottom-bar-style: raised;

    content: Gtk.ScrolledWindow {
      propagate-natural-height: true;

      child: Gtk.ListView {
        activate => $on_activate();
        single-click-activate: true;

        model: Gtk.MultiSelection selection_model {
          model: Gtk.SortListModel {
            model: bind $create_tree_model(template.current-files as <$PaperFileList>.files);

            sorter: Gtk.TreeListRowSorter {
              sorter: Gtk.MultiSorter {
                Gtk.StringSorter {
                  expression: expr item as <$PaperFileBase>.display-name;
                }
              };
            };
          };
        };

        factory: Gtk.SignalListItemFactory {
          setup => $on_note_item_setup();
          bind => $on_note_item_bind();
        };

        styles [
          "background",
        ]
      };
    };

    [top]
    Adw.HeaderBar {
        [start]
        Gtk.Button {
          icon-name: "go-previous-symbolic";
          action-name: "note-list.back";
        }
    }

    [bottom]
    Gtk.ActionBar {
      [start]
      Gtk.Button {
        icon-name: "document-new-symbolic";
        action-name: "note-list.create-note";
        action-target: "@ms nothing";
      }

      [start]
      Gtk.Button {
        icon-name: "folder-new-symbolic";
        action-name: "note-list.create-folder";
        action-target: "@ms nothing";
      }
    }
  };
}

using Gtk 4.0;
using Gio 2.0;
using Adw 1;

template $PaperLibraryView: Adw.NavigationPage {
  title: _("Home");

  Adw.NavigationSplitView {
    sidebar: Adw.NavigationPage {
      title: _("Sections");

      Adw.ToolbarView {
        bottom-bar-style: raised;

        content: $PaperLibrarySidebar sidebar {
          name-expression: expr item as <$PaperLibrarySidebarItem>.name;
          icon-name-expression: expr item as <$PaperLibrarySidebarItem>.icon-name;

          items: Gio.ListStore sidebar_items {
            item-type: typeof <$PaperLibrarySidebarItem>;
          };
        };

        [top]
        Adw.HeaderBar {
          show-title: false;

          styles [
            "flat",
          ]
        }
      }
    };

    content: Adw.NavigationPage {
      title: bind sidebar.selected-item as <$PaperLibrarySidebarItem>.name;

      Adw.ToolbarView {
        bottom-bar-style: raised;

        Gtk.ScrolledWindow {
          propagate-natural-height: true;

          Gtk.ListView {
            activate => $on_activate();

            single-click-activate: true;

            model: Gtk.MultiSelection selection_model {
              model: Gtk.SortListModel {
                model: bind $create_tree_model(sidebar.selected-item as <$PaperLibrarySidebarItem>.files);

                sorter: Gtk.TreeListRowSorter {
                    sorter: Gtk.MultiSorter {
                        Gtk.StringSorter {
                          expression: expr item as <$PaperFileBase>.display-name;
                        }
                    };
                };
              };
            };

            factory: Gtk.BuilderListItemFactory {
              resource: "/io/github/leolost2605/paper/ui/note-list-item.ui";
            };

            styles [
              "background"
            ]
          }
        }

        [top]
        Adw.HeaderBar { }

        [bottom]
        Gtk.ActionBar {
          [start]
          Gtk.Button {
            icon-name: "document-new-symbolic";
            action-name: "library.create-note";
            action-target: "@ms nothing";
          }

          [start]
          Gtk.Button {
            icon-name: "folder-new-symbolic";
            action-name: "library.create-folder";
            action-target: "@ms nothing";
          }
        }
      }
    };
  }
}

using Gtk 4.0;
using Gio 2.0;
using Adw 1;

template $PaperLibraryView: Adw.NavigationPage {
  title: _("Home");

  Adw.NavigationSplitView {
    sidebar: Adw.NavigationPage {
      title: _("Sections");

      child: Adw.ToolbarView {
        bottom-bar-style: raised;

        content: $PaperLibrarySidebar sidebar {
          name-expression: expr item as <$PaperFileList>.name;
          icon-name-expression: expr item as <$PaperFileList>.icon-name;

          items: Gio.ListStore sidebar_items {
            item-type: typeof<$PaperFileList>;
          };
        };

        [top]
        Adw.HeaderBar {
          show-title: false;

          styles [
            "flat",
          ]
        }
      };
    };

    content: Adw.NavigationPage {
      title: bind sidebar.selected-item as <$PaperFileList>.name;

      child: $PaperNoteList {
        root-files: bind sidebar.selected-item as <$PaperFileList>;
      };
    };
  }
}

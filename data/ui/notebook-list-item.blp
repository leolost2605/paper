using Gtk 4.0;
using Granite 9.0;

template ListItem {
    child: Granite.ListItem {
        text: bind template.item as <$PaperNotebook>.name;
        description: bind template.item as <$PaperNotebook>.uri;
        // menu_model: edit_menu; TODO: Seems this isn't in the API yet?
    };
}

menu edit_menu {
    item (_("Delete"), "todo")
    item (_("Rename"), "todo")
}
